# =============================================================================
# .env.autoops — variables compartidas del servidor AutoOps MCP
# =============================================================================
# Este fichero SÍ se commitea: solo placeholders y valores no sensibles.
# La API key real va en infra/.env.local (gitignored, compartida por todos los
# proyectos del portfolio — ver infra/.env.local.example).
#
# Lo consume infra/scripts/deploy.sh --project autoops para sincronizar Secrets.
#
# Mapping a Secrets de Kubernetes (lo aplica deploy.sh, ver infra/projects/autoops.env):
#   Secret "autoops-llm-secret"     ← GEMINI_API_KEY, GITHUB_TOKEN
#   Secret "wikijs-ingestion-secret" ← WIKIJS_API_KEY
#
# Weaviate corre SIN autenticación (criterio Postgres compartido, ns infra) →
# no necesita Secret. AutoOps no usa base de datos relacional.
# =============================================================================

# ── Google AI Studio (Gemini) — chat + embeddings, uso interno ────────────────
# DEJAR VACÍO aquí. La key real va en infra/.env.local (gitignored, compartida).
# Free tier: 100 RPM / 1000 RPD (suficiente para ingestar el corpus del proyecto).
# Obtener gratis en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── GitHub (lectura del monorepo para la ingesta RAG, sin clonar) ────────────
# DEJAR VACÍO aquí. El token real va en infra/.env.autoops.local (gitignored).
GITHUB_TOKEN=

# ── Wiki.js (API GraphQL: lectura de páginas para WikiJsSource) ──────────────
# DEJAR VACÍO aquí. La key real va en infra/.env.autoops.local (gitignored),
# generada en Admin Area → API Access tras desplegar Wiki.js (08-setup-wikijs.sh).
WIKIJS_API_KEY=
