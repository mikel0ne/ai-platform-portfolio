# =============================================================================
# infra/projects/autoops.env — descriptor de proyecto (AutoOps MCP)
# =============================================================================
# Lo consume infra/scripts/deploy.sh y setup-app-ingress.sh con `--project autoops`.
#
# Convención derivada de PROJECT=autoops:
#   values backend  → infra/values-autoops-backend.yaml
#   values frontend → infra/values-autoops-frontend.yaml
#   namespace       → infra/namespace-autoops.yaml
#   rbac            → infra/rbac-autoops.yaml  (SA read-only para las tools K8s)
#   secretos        → infra/.env.local  (+ .env.autoops.local, opcional)
# =============================================================================

NAMESPACE="autoops"
INGRESS_HOST="autoops.local"

IMAGE_BACKEND="registry.local/autoops-backend"
IMAGE_FRONTEND="registry.local/autoops-frontend"

CONTEXT_BACKEND="autoops/backend";   DOCKERFILE_BACKEND="docker/backend.Dockerfile"
CONTEXT_FRONTEND="autoops/frontend"; DOCKERFILE_FRONTEND="docker/frontend.Dockerfile"
# Corpus del RAG (relativo a la raíz del repo) que deploy.sh hornea en la imagen.
CORPUS_DIR="autoops/corpus"

# AutoOps NO usa context-path: el backend expone rutas en la raíz. El resto ("/")
# lo sirve el frontend Angular. /mcp es el endpoint MCP (Streamable HTTP, Spring AI 2.x).
INGRESS_BACKEND_PATHS="/search /mcp /actuator /v3/api-docs /swagger-ui"

# Secret compartido: API key de Gemini (chat + embeddings) + token de GitHub (lectura del
# monorepo para la ingesta RAG vía API, sin clonar). Weaviate corre sin auth (criterio Postgres
# compartido, ns infra). wikijs-ingestion-secret: API key de Wiki.js (lectura de páginas para
# WikiJsSource; la misma key, con scope write:pages, la usa wiki/scripts/seed-wiki-content.sh).
declare -gA SECRETS_BACKEND=(
  [autoops-llm-secret]="GEMINI_API_KEY GITHUB_TOKEN"
  [wikijs-ingestion-secret]="WIKIJS_API_KEY"
  [autoops-admin-secret]="AUTOOPS_ADMIN_TOKEN"
)
declare -gA SECRETS_FRONTEND=()
