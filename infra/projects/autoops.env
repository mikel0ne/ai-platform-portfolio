# =============================================================================
# infra/projects/autoops.env — descriptor de proyecto (AutoOps MCP)
# =============================================================================
# Lo consume infra/scripts/deploy.sh y setup-app-ingress.sh con `--project autoops`.
#
# Convención derivada de PROJECT=autoops:
#   values backend  → infra/values-autoops-backend.yaml
#   values frontend → infra/values-autoops-frontend.yaml
#   namespace       → infra/namespace-autoops.yaml
#   rbac            → infra/rbac-autoops.yaml  (SA read-only para las tools K8s)
#   env compartido  → infra/.env.autoops  (+ .env.autoops.local con la API key)
# =============================================================================

NAMESPACE="autoops"
INGRESS_HOST="autoops.local"

IMAGE_BACKEND="registry.local/autoops-backend"
IMAGE_FRONTEND="registry.local/autoops-frontend"

CONTEXT_BACKEND="backend";   DOCKERFILE_BACKEND="docker/backend.Dockerfile"
CONTEXT_FRONTEND="frontend"; DOCKERFILE_FRONTEND="docker/frontend.Dockerfile"

# AutoOps NO usa context-path: el backend expone rutas en la raíz. El resto ("/")
# lo sirve el frontend Angular. /sse es el endpoint MCP por SSE.
INGRESS_BACKEND_PATHS="/search /sse /actuator /v3/api-docs /swagger-ui"

# Único Secret: la API key de Gemini (chat + embeddings, uso interno).
# Weaviate corre sin auth (criterio Postgres compartido, ns infra).
declare -gA SECRETS_BACKEND=(
  [autoops-llm-secret]="GEMINI_API_KEY"
)
declare -gA SECRETS_FRONTEND=()
