# =============================================================================
# infra/projects/autoops.env: project descriptor (AutoOps MCP)
# =============================================================================
# Read by infra/scripts/deploy.sh and setup-app-ingress.sh with `--project autoops`.
#
# Conventions derived from PROJECT=autoops:
#   values backend  → infra/values-autoops-backend.yaml
#   values frontend → infra/values-autoops-frontend.yaml
#   namespace       → infra/namespace-autoops.yaml
#   rbac            -> infra/rbac-autoops.yaml  (read-only SA for the Kubernetes tools)
#   secrets         -> infra/.env.local  (+ .env.autoops.local, optional)
# =============================================================================

NAMESPACE="autoops"
INGRESS_HOST="autoops.local"

IMAGE_BACKEND="registry.local/autoops-backend"
IMAGE_FRONTEND="registry.local/autoops-frontend"

CONTEXT_BACKEND="autoops/backend";   DOCKERFILE_BACKEND="docker/backend.Dockerfile"
CONTEXT_FRONTEND="autoops/frontend"; DOCKERFILE_FRONTEND="docker/frontend.Dockerfile"
# RAG corpus (relative to the repo root) that deploy.sh bakes into the image.
CORPUS_DIR="autoops/corpus"

# AutoOps has no context path: the backend serves from the root and the Angular
# frontend gets "/". /mcp is the MCP endpoint (Streamable HTTP, Spring AI 2.x).
INGRESS_BACKEND_PATHS="/search /mcp /actuator /v3/api-docs /swagger-ui"

# Secrets: Gemini key (chat + embeddings) and GitHub token (reads the repo for RAG
# ingestion through the API, no clone); Wiki.js key (page reads for WikiJsSource; the
# same key with write:pages is used by wiki/scripts/seed-wiki-content.sh); /admin token.
# Weaviate runs without auth (local, shared in the infra namespace).
declare -gA SECRETS_BACKEND=(
  [autoops-llm-secret]="GEMINI_API_KEY GITHUB_TOKEN"
  [wikijs-ingestion-secret]="WIKIJS_API_KEY"
  [autoops-admin-secret]="AUTOOPS_ADMIN_TOKEN"
)
declare -gA SECRETS_FRONTEND=()
