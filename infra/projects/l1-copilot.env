# =============================================================================
# infra/projects/l1-copilot.env: project descriptor (L1 Support Copilot)
# =============================================================================
# Read by infra/scripts/deploy.sh and setup-app-ingress.sh with `--project l1-copilot`.
# Everything project-specific lives here; the scripts are generic.
#
# Conventions (derived by deploy.sh from PROJECT, nothing to declare):
#   values backend  → infra/values-l1-copilot-backend.yaml
#   values frontend → infra/values-l1-copilot-frontend.yaml
#   namespace       → infra/namespace-l1-copilot.yaml
#   rbac (optional) -> infra/rbac-l1-copilot.yaml  (absent -> skipped)
#   secrets         -> infra/.env.local  (+ .env.l1-copilot.local, optional)
# =============================================================================

NAMESPACE="l1-copilot"
INGRESS_HOST="l1-copilot.local"

# Images in the local registry (registry.local); the tag comes from --tag or the manifest.
IMAGE_BACKEND="registry.local/l1-copilot-backend"
IMAGE_FRONTEND="registry.local/l1-copilot-frontend"

# Build contexts, relative to the repo root.
CONTEXT_BACKEND="l1-copilot/backend";   DOCKERFILE_BACKEND="docker/backend.Dockerfile"
CONTEXT_FRONTEND="l1-copilot/frontend"; DOCKERFILE_FRONTEND="docker/frontend.Dockerfile"
# No RAG corpus (L1 uses Postgres): deploy.sh bakes an empty /app/corpus.

# Paths the Ingress sends to the backend (everything else, "/", goes to the frontend).
# L1 serves the whole backend under /api (server.servlet.context-path).
INGRESS_BACKEND_PATHS="/api"

# Kubernetes Secrets <- env vars (filled by deploy.sh from infra/.env.local).
declare -gA SECRETS_BACKEND=(
  [gemini-api-key]="GEMINI_API_KEY"
  [postgres-credentials]="POSTGRES_USER POSTGRES_PASSWORD"
)
declare -gA SECRETS_FRONTEND=()
