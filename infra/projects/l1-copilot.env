# =============================================================================
# infra/projects/l1-copilot.env — descriptor de proyecto (L1 Support Copilot)
# =============================================================================
# Lo consume infra/scripts/deploy.sh y setup-app-ingress.sh cuando se invocan
# con `--project l1-copilot`. Aquí vive TODO lo específico del proyecto; los
# scripts son genéricos.
#
# Convención (no hace falta declararlo aquí, deploy.sh lo deriva de PROJECT):
#   values backend  → infra/values-l1-copilot-backend.yaml
#   values frontend → infra/values-l1-copilot-frontend.yaml
#   namespace       → infra/namespace-l1-copilot.yaml
#   rbac (opcional) → infra/rbac-l1-copilot.yaml  (no existe → se ignora)
#   env compartido  → infra/.env.l1-copilot  (+ .env.l1-copilot.local)
# =============================================================================

NAMESPACE="l1-copilot"
INGRESS_HOST="l1-copilot.local"

# Imágenes en el registry local (registry.local). El tag se pasa con --tag.
IMAGE_BACKEND="registry.local/l1-copilot-backend"
IMAGE_FRONTEND="registry.local/l1-copilot-frontend"

# Build: contexto + Dockerfile (relativos a la raíz del repo).
# Tras la reestructuración a monorepo, basta cambiar el contexto aquí
# (p.ej. CONTEXT_BACKEND="l1-copilot/backend"); deploy.sh no se toca.
CONTEXT_BACKEND="backend";   DOCKERFILE_BACKEND="docker/backend.Dockerfile"
CONTEXT_FRONTEND="frontend"; DOCKERFILE_FRONTEND="docker/frontend.Dockerfile"

# Rutas que el Ingress envía al backend (todo lo demás, "/", va al frontend).
# L1 sirve todo el backend bajo /api (server.servlet.context-path).
INGRESS_BACKEND_PATHS="/api"

# Secret de K8s ← env vars (las rellena deploy.sh desde .env.l1-copilot[.local]).
declare -gA SECRETS_BACKEND=(
  [gemini-api-key]="GEMINI_API_KEY"
  [postgres-credentials]="POSTGRES_USER POSTGRES_PASSWORD"
)
declare -gA SECRETS_FRONTEND=()
