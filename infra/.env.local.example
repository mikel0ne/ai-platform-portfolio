# =============================================================================
# infra/.env.local — local secrets shared by every project (NEVER commit it)
# =============================================================================
# cp infra/.env.local.example infra/.env.local and fill in the values.
# Loaded by infra/scripts/deploy.sh, the database/observability setup scripts and
# the IntelliJ run configurations (EnvFile plugin).
# Optional per-project overrides go in infra/.env.<project>.local (also gitignored).
# =============================================================================

# Google AI Studio (Gemini): chat + embeddings. Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Shared PostgreSQL in the `infra` namespace (03-setup-postgres.sh creates it with these).
POSTGRES_USER=appuser
POSTGRES_PASSWORD=

# Grafana admin password (07-setup-observability.sh).
GRAFANA_ADMIN_PASSWORD=

# AutoOps RAG ingestion: GitHub token (read-only, public repos) and Wiki.js API key
# (Admin Area → API Access after 08-setup-wikijs.sh).
GITHUB_TOKEN=
WIKIJS_API_KEY=

# AutoOps /admin/* endpoints (ingestion, vector store drop). Any long random string, e.g. openssl rand -hex 32.
AUTOOPS_ADMIN_TOKEN=
