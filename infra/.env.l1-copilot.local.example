# Google AI Studio — obtén la tuya en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-REEMPLAZAME

# Si quieres rotar credenciales de Postgres solo para tu entorno local:
# POSTGRES_USER=otro_usuario
# POSTGRES_PASSWORD=otra_password
