# =============================================================================
# .env.l1-copilot.local — overrides LOCALES de este proyecto (NO commitear)
# =============================================================================
# Para la GEMINI_API_KEY usa infra/.env.local (compartida por todos los
# proyectos del portfolio, ver infra/.env.local.example) — normalmente NO
# hace falta este fichero. Resérvalo para overrides específicos de
# l1-copilot, p.ej. rotar Postgres solo en tu entorno:
# =============================================================================

# POSTGRES_USER=otro_usuario
# POSTGRES_PASSWORD=otra_password

# Override puntual de la key compartida (raro — normalmente basta .env.local):
# GEMINI_API_KEY=AIza-REEMPLAZAME
